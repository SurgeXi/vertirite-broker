{
  "openapi": "3.1.0",
  "info": {
    "title": "Vertirite governance API (public subset)",
    "version": "0.2.0",
    "description": "Approval gate, audit read, mode authority and health. Generated from the broker source; the full API ships with the product."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "PUBLIC liveness \u2014 intentionally minimal. Returns only {status, service}\nso an anonymous caller (the endpoint is exposed on the public demo) cannot\nread internal topology. The detailed health lives at /v1/health behind auth.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/mode": {
      "get": {
        "summary": "Get Mode",
        "description": "Read the current governance mode (gate 01).\n\nAny authenticated caller can READ the mode. Returns the effective mode (what\nthe gate enforces), the local authoritative mode, surge-core reachability,\nand \u2014 when surge-core is reachable \u2014 the mode it reports. Setting the mode\nis a separate, auth-isolated path (POST /v1/mode, governor credential only).",
        "operationId": "get_mode_v1_mode_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Mode V1 Mode Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Set Mode",
        "description": "Set the LOCAL authoritative governance mode (gate 01).\n\nAuthorized ONLY through the governor trust domain (require_governor) \u2014 a\ncredential the agent plane can never hold, keeping mode authority\nout-of-band. The change persists across restarts and is audit-logged.\nsurge-core can still TIGHTEN the effective mode above what is set here, but\ncan never loosen it.",
        "operationId": "set_mode_v1_mode_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetModeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Set Mode V1 Mode Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit/me": {
      "get": {
        "summary": "My Audit Events",
        "description": "Per-tenant audit feed \u2014 every action surge or maestro took on this user's\nbehalf. Differentiator from PR #19 launch-readiness Day 3.1.\n\nFilters by `actor.user_id`. Customers get full visibility into \"what did\nthe AI do for me this week\" \u2014 surface this in the dashboard's Activity tab.",
        "operationId": "my_audit_events_v1_audit_me_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "action_prefix",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action Prefix"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEventRecord"
                  },
                  "title": "Response My Audit Events V1 Audit Me Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/approvals": {
      "get": {
        "summary": "Get Approvals",
        "operationId": "get_approvals_v1_approvals_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalRecord"
                  },
                  "title": "Response Get Approvals V1 Approvals Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Approval Request",
        "description": "Ask a human before a gated action. Stored PENDING, announced on the configured channels,\nre-announced while waiting, and DENIED automatically at its deadline.",
        "operationId": "create_approval_request_v1_approvals_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/approvals/{approval_id}/approve": {
      "post": {
        "summary": "Approve Request",
        "operationId": "approve_request_v1_approvals__approval_id__approve_post",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Approval Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/approvals/{approval_id}/deny": {
      "post": {
        "summary": "Deny Request",
        "operationId": "deny_request_v1_approvals__approval_id__deny_post",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Approval Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalCreateRequest": {
        "properties": {
          "tool_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Tool Name"
          },
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Summary"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "title": "Session Id",
            "default": ""
          },
          "timeout_s": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout S"
          }
        },
        "type": "object",
        "required": [
          "tool_name",
          "summary"
        ],
        "title": "ApprovalCreateRequest",
        "description": "An integrating system asks a human before a gated action (POST /v1/approvals)."
      },
      "ApprovalDecisionRequest": {
        "properties": {
          "decision_notes": {
            "type": "string",
            "title": "Decision Notes",
            "default": ""
          }
        },
        "type": "object",
        "title": "ApprovalDecisionRequest"
      },
      "ApprovalRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          },
          "mode_at_submit": {
            "$ref": "#/components/schemas/SurgeMode"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "surge_task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Surge Task Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "decision_notes": {
            "type": "string",
            "title": "Decision Notes",
            "default": ""
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "notify_count": {
            "type": "integer",
            "title": "Notify Count",
            "default": 0
          },
          "last_notified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Notified At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "session_id",
          "actor_id",
          "tool_name",
          "mode_at_submit",
          "status",
          "summary",
          "payload",
          "created_at",
          "updated_at"
        ],
        "title": "ApprovalRecord"
      },
      "AuditEventRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "entity_type": {
            "type": "string",
            "title": "Entity Type"
          },
          "entity_id": {
            "type": "string",
            "title": "Entity Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "actor_id",
          "action",
          "entity_type",
          "entity_id",
          "summary",
          "created_at"
        ],
        "title": "AuditEventRecord"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "surge-operator-broker"
          }
        },
        "type": "object",
        "title": "LivenessResponse",
        "description": "Minimal, UNAUTHENTICATED liveness. Deliberately carries NO internal\ntopology (no DB host, environment, surge-core mode, or reachability) \u2014 those\nmoved to the authenticated /v1/health so an anonymous caller on the public\ndemo can't read the deployment's internals."
      },
      "SetModeRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "SetModeRequest"
      },
      "SurgeMode": {
        "type": "string",
        "enum": [
          "AUTONOMOUS",
          "CONTROLLED",
          "LOCKDOWN",
          "ESCALATION_REQUIRED"
        ],
        "title": "SurgeMode"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}