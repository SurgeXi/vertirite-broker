SURGE_OPERATOR_ENVIRONMENT=development
SURGE_OPERATOR_DATABASE_URL=postgresql+psycopg://surge:surge@127.0.0.1:5432/surge_operator
SURGE_OPERATOR_SURGE_CORE_URL=http://127.0.0.1:7070
SURGE_OPERATOR_BROKER_API_TOKEN=change-me-broker-token
SURGE_OPERATOR_BRIDGE_API_TOKEN=change-me-bridge-token
SURGE_OPERATOR_BOOTSTRAP_USER_ID=operator
SURGE_OPERATOR_FORWARD_APPROVALS_TO_SURGE_CORE=false
# Local mode authority: provision a governor credential out-of-band to make the
# POST /v1/mode set-path operational (otherwise the broker runs UNGOVERNED).
# SURGE_OPERATOR_GOVERNOR_TOKEN=change-me-governor-token
# Host-local operational context directory (real *.md files, never committed).
# Unset → the broker serves sanitized fixtures and reports context_source=fixtures.
# SURGE_OPERATOR_CONTEXT_DIR=/path/to/host-local/context
